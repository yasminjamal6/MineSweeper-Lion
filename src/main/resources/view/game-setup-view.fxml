<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="root" id="gameSetupRoot"
           prefWidth="1200" prefHeight="800"
           maxHeight="Infinity"
           maxWidth="Infinity"
           minHeight="0"
           minWidth="0"
           stylesheets="@/css/game-setup.css"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="main.controller.GameSetupController">

    <fx:define>
        <ToggleGroup fx:id="difficultyGroup" />
    </fx:define>

    <children>
        <AnchorPane styleClass="background-pane"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    maxHeight="Infinity"
                    minHeight="0">


            <children>
                <VBox alignment="CENTER"
                      spacing="24"
                      AnchorPane.topAnchor="0"
                      AnchorPane.bottomAnchor="0"
                      AnchorPane.leftAnchor="0"
                      AnchorPane.rightAnchor="0"
                      style="-fx-padding: 10 80 10 80;">

                    <VBox fx:id="mainCard"
                          alignment="TOP_CENTER"
                          spacing="14"
                          styleClass="card-main">

                        <!-- Back to home -->
                        <HBox alignment="CENTER_RIGHT">
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="backToHomeButton"
                                    onAction="#onBack"
                                    styleClass="secondary-action-btn small-back-btn"
                                    text="Back to Home">
                                <tooltip>
                                    <Tooltip text="Return to the main menu"/>
                                </tooltip>
                            </Button>
                        </HBox>

                        <!-- Title + subtitle -->
                        <VBox alignment="CENTER" spacing="6">
                            <Label id="setupTitleLabel"
                                   styleClass="title-label"
                                   text="Prepare the Den" />
                            <Label id="setupSubtitleLabel"
                                   styleClass="subtitle-label"
                                   text="Get your lions ready for the challenge!" />
                        </VBox>

                        <!-- Players -->
                        <HBox alignment="CENTER" spacing="22" fx:id="playersRow">

                            <!-- Player A -->
                            <VBox spacing="10" styleClass="player-card">
                                <Label id="playerATitleLabel"
                                       styleClass="player-title" text="Player A 🦁" />
                                <Label id="playerANameLabel"
                                       styleClass="field-label" text="Player name" />
                                <TextField fx:id="playerAName"
                                           promptText="Enter name..."
                                           styleClass="name-field" />

                                <Label id="playerAAvatarLabel"
                                       styleClass="field-label" text="Avatar" />
                                <HBox fx:id="avatarPickerA"
                                      alignment="CENTER" spacing="10"/>

                                <Label id="playerABoardLabel"
                                       styleClass="field-label" text="Board style" />
                                <HBox fx:id="themePickerA"
                                      alignment="CENTER" spacing="10"/>
                            </VBox>

                            <!-- Player B -->
                            <VBox spacing="10" styleClass="player-card">
                                <Label id="playerBTitleLabel"
                                       styleClass="player-title" text="Player B 🦁" />
                                <Label id="playerBNameLabel"
                                       styleClass="field-label" text="Player name" />
                                <TextField fx:id="playerBName"
                                           promptText="Enter name..."
                                           styleClass="name-field" />

                                <Label id="playerBAvatarLabel"
                                       styleClass="field-label" text="Avatar" />
                                <HBox fx:id="avatarPickerB"
                                      alignment="CENTER" spacing="10"/>

                                <Label id="playerBBoardLabel"
                                       styleClass="field-label" text="Board style" />
                                <HBox fx:id="themePickerB"
                                      alignment="CENTER" spacing="10"/>


                            </VBox>
                        </HBox>

                        <CheckBox fx:id="playerBAICheckbox"
                                  text="Play WITH Lion AI 🦁"
                                  onAction="#onTogglePlayerBAI"
                                  styleClass="ai-checkbox"/>
                        <!-- Difficulty -->
                        <VBox fx:id="difficultyBox" alignment="CENTER" spacing="10">
                            <Label id="challengeTitleLabel"
                                   styleClass="section-title"
                                   text="Choose the challenge level" />
                            <HBox alignment="CENTER" spacing="14">

                                <ToggleButton fx:id="easyBtn" id="easyBtn"
                                              styleClass="difficulty-btn"
                                              text="Easy"
                                              toggleGroup="$difficultyGroup">
                                    <tooltip>
                                        <Tooltip text="Smaller board, fewer mines."/>
                                    </tooltip>
                                </ToggleButton>

                                <ToggleButton fx:id="mediumBtn" id="mediumBtn"
                                              styleClass="difficulty-btn"
                                              text="Medium"
                                              toggleGroup="$difficultyGroup">
                                    <tooltip>
                                        <Tooltip text="Balanced challenge for both lions."/>
                                    </tooltip>
                                </ToggleButton>

                                <ToggleButton fx:id="hardBtn" id="hardBtn"
                                              styleClass="difficulty-btn"
                                              text="Hard"
                                              toggleGroup="$difficultyGroup">
                                    <tooltip>
                                        <Tooltip text="Big board, many mines – for brave lions only."/>
                                    </tooltip>
                                </ToggleButton>

                            </HBox>
                        </VBox>

                        <!-- Start button -->
                        <HBox fx:id="startRow" alignment="CENTER">
                            <Button id="startAdventureButton"
                                    onAction="#onStart"
                                    styleClass="primary-action-btn"
                                    text="Start the Adventure 🦁" />
                        </HBox>


                    </VBox>
                </VBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
