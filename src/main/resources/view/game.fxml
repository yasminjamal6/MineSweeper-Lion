<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>


<AnchorPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.controller.GameController"
            fx:id="root"
            prefWidth="1200.0" prefHeight="700.0"
            stylesheets="@/css/game.css"
            styleClass="game-root">

    <children>
        <StackPane fx:id="rootStack"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">
            <AnchorPane fx:id="gameContent" maxWidth="Infinity" maxHeight="Infinity">

                <!-- שכבת שחור מעל התמונה (כמעט מסתירה אותה) -->
                <Pane styleClass="bg-overlay"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0"
                      AnchorPane.rightAnchor="0.0" />

                <VBox spacing="12"
                      AnchorPane.topAnchor="10.0"
                      AnchorPane.bottomAnchor="10.0"
                      AnchorPane.leftAnchor="10.0"
                      AnchorPane.rightAnchor="10.0">

            <Label text="Avoid Scar! Right-click to place Simba's paw marks"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   styleClass="hint-text"/>

            <!-- TOP BAR -->
            <HBox spacing="10" alignment="CENTER" styleClass="top-bar">

                <Label fx:id="scoreLabel"
                       text="Score: 0 🏆"
                       styleClass="score-label"/>

                <Label fx:id="timerLabel"
                       text="00:00"
                       styleClass="timer-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox fx:id="heartsBox"
                      alignment="CENTER"
                      spacing="0"
                      styleClass="hearts-row"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="livesLabel"
                       text="10 / 10"
                       styleClass="lives-counter"/>

                <!-- PAUSE BUTTON -->
                <Button fx:id="pauseBtn"
                        onAction="#onPause"
                        styleClass="back-home-btn">
                    <graphic>
                        <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                            <image>
                                <Image url="@/images/puse0.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="restartBtn"
                        onAction="#onRestart"
                        styleClass="back-home-btn">
                    <graphic>
                        <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                            <image>
                                <Image url="@/images/reload.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <Button fx:id="hintBtn"
                        onAction="#onHint"
                        styleClass="back-home-btn">
                    <graphic>
                        <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                            <image>
                                <Image url="@/images/hint.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>



                <Button fx:id="backHomeBtn"
                        onAction="#onBackToHome"
                        styleClass="back-home-btn">

                    <graphic>
                        <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                            <image>
                                <Image url="@/images/home.png"/>                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- ===== BOARDS ===== -->
            <HBox spacing="16" VBox.vgrow="ALWAYS">

                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <VBox alignment="CENTER" spacing="6">
                        <HBox alignment="CENTER" spacing="8"
                              styleClass="player-header player-header-a">
                            <ImageView fx:id="playerAAvatarView"
                                       fitWidth="26" fitHeight="26"
                                       preserveRatio="true"
                                       smooth="true"
                                       styleClass="player-avatar"/>
                            <Label fx:id="playerANameLabel"
                                   text="Player A"
                                   styleClass="player-name"/>
                        </HBox>

                        <HBox alignment="CENTER" spacing="6"
                              styleClass="mines-chip">
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true" smooth="true">
                                <image>
                                    <Image url="@/images/bomb2.png"/>
                                </image>
                            </ImageView>

                            <Label fx:id="playerAMinesLabel"
                                   text="10"
                                   styleClass="mines-count"/>
                            <Label text="MINES" styleClass="mines-text"/>
                        </HBox>
                    </VBox>

                    <!-- תור של שחקן A -->
                    <Label fx:id="turnALabel"
                           text="Your turn"
                           alignment="CENTER"
                           styleClass="turn-label"/>

                    <Label text="Board A" styleClass="board-title"/>

                    <StackPane fx:id="boardAContainer"
                               styleClass="board-container"
                               VBox.vgrow="ALWAYS">
                        <GridPane fx:id="boardAGrid"
                                  hgap="2" vgap="2"
                                  alignment="CENTER"/>
                        <StackPane fx:id="rewardToastA"
                                   visible="false"
                                   mouseTransparent="true"
                                   alignment="TOP_RIGHT"
                                   styleClass="reward-toast">
                            <HBox alignment="CENTER" spacing="6" styleClass="reward-toast-card">
                                <Label text="⭐" styleClass="reward-toast-icon"/>
                                <Label fx:id="rewardToastLabelA"
                                       text="Correct! +3×3 revealed"
                                       styleClass="reward-toast-text"/>
                            </HBox>
                        </StackPane>
                    </StackPane>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <VBox alignment="CENTER" spacing="6">
                        <HBox alignment="CENTER" spacing="8"
                              styleClass="player-header player-header-b">
                            <ImageView fx:id="playerBAvatarView"
                                       fitWidth="26" fitHeight="26"
                                       preserveRatio="true"
                                       smooth="true"
                                       styleClass="player-avatar"/>
                            <Label fx:id="playerBNameLabel"
                                   text="Player B"
                                   styleClass="player-name"/>
                        </HBox>

                        <HBox alignment="CENTER" spacing="6"
                              styleClass="mines-chip">
                            <ImageView fitWidth="20" fitHeight="20" preserveRatio="true" smooth="true">
                                <image>
                                    <Image url="@/images/bomb2.png"/>
                                </image>
                            </ImageView>

                            <Label fx:id="playerBMinesLabel"
                                   text="10"
                                   styleClass="mines-count"/>
                            <Label text="MINES" styleClass="mines-text"/>
                        </HBox>
                    </VBox>
                    <!-- תור של שחקן B -->
                    <Label fx:id="turnBLabel"
                           text="Your turn"
                           alignment="CENTER"
                           styleClass="turn-label"/>

                    <Label text="Board B" styleClass="board-title"/>

                    <StackPane fx:id="boardBContainer"
                               styleClass="board-container"
                               VBox.vgrow="ALWAYS">
                        <GridPane fx:id="boardBGrid"
                                  hgap="2" vgap="2"
                                  alignment="CENTER"/>
                        <StackPane fx:id="rewardToastB"
                                   visible="false"
                                   mouseTransparent="true"
                                   alignment="TOP_RIGHT"
                                   styleClass="reward-toast">
                            <HBox alignment="CENTER" spacing="6" styleClass="reward-toast-card">
                                <Label text="⭐" styleClass="reward-toast-icon"/>
                                <Label fx:id="rewardToastLabelB"
                                       text="Correct! +3×3 revealed"
                                       styleClass="reward-toast-text"/>
                            </HBox>
                        </StackPane>
                    </StackPane>
                </VBox>

            </HBox>

            <HBox alignment="CENTER"
                  spacing="40"
                  styleClass="legend-row">


                <!-- Simba's Mark (Flag) -->
                <HBox alignment="CENTER" spacing="8">
                    <Label text="🐾"
                           styleClass="legend-flag-icon"/>
                    <Label text="Simba's Mark (Flag)"
                           styleClass="legend-text"/>
                </HBox>

            </HBox>

                </VBox>

                <!-- Countdown overlay -->
                <StackPane fx:id="countdownOverlay"
                           visible="false"
                           mouseTransparent="true"
                           AnchorPane.topAnchor="0.0"
                           AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0"
                           AnchorPane.rightAnchor="0.0"
                           styleClass="countdown-overlay">
                    <VBox alignment="CENTER" spacing="12" styleClass="countdown-card">
                        <Label text="Get Ready" styleClass="countdown-title"/>
                        <Label fx:id="countdownLabel" text="3" styleClass="countdown-number"/>
                        <ImageView fitWidth="140" fitHeight="110" preserveRatio="true" smooth="true" styleClass="countdown-gif">
                            <image>
                                <Image url="@../images/simba-walk.gif"/>
                            </image>
                        </ImageView>
                    </VBox>
                </StackPane>

                <!-- Resume overlay -->
                <StackPane fx:id="resumeOverlay"
                           visible="false"
                           mouseTransparent="true"
                           AnchorPane.topAnchor="0.0"
                           AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0"
                           AnchorPane.rightAnchor="0.0"
                           styleClass="resume-overlay">
                    <VBox alignment="CENTER" spacing="12" styleClass="resume-card">
                        <Label text="Resume Game" styleClass="resume-title"/>
                        <Label text="Continue where you left off or start fresh"
                               styleClass="resume-subtitle"/>
                        <ImageView fitWidth="140" fitHeight="110" preserveRatio="true" smooth="true" styleClass="resume-gif">
                            <image>
                                <Image url="@../images/simba-walk.gif"/>
                            </image>
                        </ImageView>
                        <HBox alignment="CENTER" spacing="14" styleClass="resume-actions">
                            <Button text="Continue"
                                    onAction="#onResumeContinue"
                                    styleClass="resume-btn resume-continue"/>
                            <Button text="New Game"
                                    onAction="#onResumeNewGame"
                                    styleClass="resume-btn resume-new"/>
                        </HBox>
                    </VBox>
                </StackPane>
            </AnchorPane>

            <!-- Tutorial overlay visuals -->
            <StackPane fx:id="tutorialOverlay"
                       visible="false"
                       mouseTransparent="true"
                       pickOnBounds="false"
                       maxWidth="Infinity"
                       maxHeight="Infinity"
                       styleClass="tutorial-overlay">
                <Pane fx:id="tutorialMask" pickOnBounds="false"/>
                <Pane fx:id="tutorialContent" pickOnBounds="false">
                    <Label fx:id="tutorialArrow"
                           text="⬇"
                           styleClass="tutorial-arrow"/>
                    <Label fx:id="tutorialText"
                           text="Click the glowing safe cell to reveal it."
                           styleClass="tutorial-text"/>
                </Pane>
            </StackPane>

            <!-- Tutorial controls layer (clickable button only) -->
            <AnchorPane fx:id="tutorialSkipLayer"
                        visible="false"
                        mouseTransparent="false"
                        pickOnBounds="false"
                        maxWidth="Infinity"
                        maxHeight="Infinity">
                <Button fx:id="tutorialSkipBtn"
                        text="Skip Tutorial"
                        onAction="#onSkipTutorial"
                        styleClass="tutorial-skip"
                        AnchorPane.topAnchor="16.0"
                        AnchorPane.rightAnchor="16.0"/>
            </AnchorPane>
        </StackPane>

    </children>
</AnchorPane>
