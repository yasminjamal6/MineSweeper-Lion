<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.controller.HowToPlayController"
            prefWidth="900" prefHeight="650"
            stylesheets="@/css/home.css"
            styleClass="how-root"
            fx:id="rootPane">

    <children>

        <VBox spacing="12.0"
              AnchorPane.topAnchor="10.0"
              AnchorPane.leftAnchor="10.0"
              AnchorPane.rightAnchor="10.0"
              AnchorPane.bottomAnchor="10.0"
              styleClass="how-card">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" fx:id="headerRow">
                <Label text="🦁" style="-fx-font-size: 26;"/>
                <Label fx:id="titleLabel"
                       text="How to Play?"
                       styleClass="how-header-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="closeButton"
                        text="✕"
                        styleClass="how-close-btn"
                        onAction="#onCloseHowToPlay"/>
            </HBox>

            <Region prefHeight="3.0" styleClass="how-header-line"/>

            <!-- Scrollable content -->
            <ScrollPane fx:id="contentCard"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="how-scroll">
                <content>
                    <VBox spacing="18.0">
                        <padding>
                            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                        </padding>

                        <!-- Objective -->
                        <VBox spacing="10.0" styleClass="objective-box">
                            <Label fx:id="objectiveTitleLabel"
                                   text="🎯  Objective"
                                   styleClass="how-section-title"/>
                            <Label fx:id="objectiveTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Reveal safe cells and avoid mines.\n• Each player has their own board and takes turns.\n• Protect your hearts and aim for the highest score."/>
                        </VBox>

                        <!-- Controls -->
                        <VBox spacing="8.0" styleClass="bomb-box">
                            <Label fx:id="controlsTitleLabel"
                                   text="🕹  Controls"
                                   styleClass="how-box-title"/>
                            <Label fx:id="controlsTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Left click = reveal a cell.\n• Right click = place or remove Simba's Mark/flag (paw mark) on suspected mines."/>
                        </VBox>

                        <!-- Numbers -->
                        <VBox spacing="8.0" styleClass="numbers-box">
                            <Label fx:id="numbersTitleLabel"
                                   text="🔢  Numbers"
                                   styleClass="how-box-title"/>
                            <Label fx:id="numbersTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• A number shows how many mines are adjacent to that cell."/>
                        </VBox>

                        <!-- Lives -->
                        <VBox spacing="8.0" styleClass="trivia-box">
                            <Label fx:id="livesTitleLabel"
                                   text="❤️  Lives"
                                   styleClass="how-box-title"/>
                            <Label fx:id="livesTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• You start with hearts; hitting a mine removes 1 heart.\n• When your hearts run out, you lose."/>
                        </VBox>

                        <!-- Score / Points -->
                        <VBox spacing="10.0" styleClass="how-howplay-box">
                            <Label fx:id="scoreTitleLabel"
                                   text="🏆  Score / Points"
                                   styleClass="how-section-title"/>
                            <Label fx:id="scoreTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Safe reveals and steady progress add points.\n• Correct flags add points; wrong flags reduce points.\n• Trivia Questions can add or subtract points (impact scales with difficulty).\n• Mines, Risky Surprises, and using a hint reduce points."/>
                        </VBox>

                        <!-- Hints -->
                        <VBox spacing="8.0" styleClass="objective-box">
                            <Label fx:id="hintsTitleLabel"
                                   text="💡  Hints"
                                   styleClass="how-box-title"/>
                            <Label fx:id="hintsTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Each player has exactly 2 hints per game.\n• Use the Hint button to highlight a safe cell; hints are limited and cost points."/>
                        </VBox>

                        <!-- Gift / Surprise system -->
                        <VBox spacing="8.0" styleClass="surprise-box">
                            <Label fx:id="surpriseTitleLabel"
                                   text="🎁  Gift / Surprise System"
                                   styleClass="how-box-title"/>
                            <Label fx:id="surpriseTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Lucky Surprise can give +Lives and/or +Points.\n• Risky Surprise can subtract Lives/Points."/>
                        </VBox>

                        <!-- Difficulty -->
                        <VBox spacing="8.0" styleClass="numbers-box">
                            <Label fx:id="difficultyTitleLabel"
                                   text="🧭  Difficulty"
                                   styleClass="how-box-title"/>
                            <Label fx:id="difficultyTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Easy / Medium / Hard — more mines means a harder game."/>
                        </VBox>

                        <!-- Profiles -->
                        <VBox spacing="8.0" styleClass="trivia-box">
                            <Label fx:id="profilesTitleLabel"
                                   text="👤  Profiles"
                                   styleClass="how-box-title"/>
                            <Label fx:id="profilesTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Enter your profile from the Home screen.\n• Change your avatar inside the Profile page.\n• Profiles show match history and stats."/>
                        </VBox>

                        <!-- Quick tips -->
                        <VBox spacing="10.0" styleClass="how-tips-box">
                            <Label fx:id="tipsTitleLabel"
                                   text="🏁  Quick Tips"
                                   styleClass="how-section-title"/>
                            <Label fx:id="tipsTextLabel"
                                   wrapText="true"
                                   styleClass="how-box-text"
                                   text="• Use flags to track suspected mines.\n• Don't rush—clear safe areas step by step.\n• Save hints for tough moments."/>
                        </VBox>

                        <!-- Bottom button -->
                        <HBox alignment="CENTER" fx:id="actionsRow">
                            <padding>
                                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                            </padding>
                            <Button fx:id="startButton"
                                    text="Got it, let's start! 🦁"
                                    styleClass="how-start-btn"
                                    onAction="#onStartGame"/>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

        </VBox>

    </children>

</AnchorPane>
