<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.controller.ProfileController"
            stylesheets="@/css/player-profile.css"
            prefWidth="1200.0" prefHeight="800.0"
            styleClass="profile-root">

    <children>
        <VBox spacing="16"
              AnchorPane.topAnchor="16.0"
              AnchorPane.bottomAnchor="16.0"
              AnchorPane.leftAnchor="16.0"
              AnchorPane.rightAnchor="16.0">

            <!-- HEADER (same as your old design) -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="profile-header">
                <Button text="← Back"
                        onAction="#onBackHome"
                        styleClass="profile-back"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Player Profile" styleClass="profile-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="shopBtn"
                        text="🛒 Shop"
                        onAction="#onOpenShop"
                        styleClass="profile-back"/>
            </HBox>

            <HBox spacing="16" VBox.vgrow="ALWAYS">
                <!-- LEFT PANEL (viewer) -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="profile-card">
                        <ImageView fx:id="avatarView"
                                   fitWidth="64" fitHeight="64"
                                   preserveRatio="true"
                                   smooth="true"
                                   styleClass="profile-avatar"/>
                        <VBox spacing="6">
                            <Label fx:id="playerNameLabel"
                                   text="Player"
                                   styleClass="profile-name"/>
                            <Label fx:id="playerSubtitleLabel"
                                   text="Your Profile"
                                   styleClass="profile-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox spacing="4" alignment="CENTER_RIGHT">
                            <Label fx:id="coinsLabel"
                                   text="Coins: 0"
                                   styleClass="profile-subtitle"/>
                            <Label fx:id="selectedAvatarLabel"
                                   text="Selected Avatar: SIMBA"
                                   styleClass="profile-subtitle"/>
                            <Label fx:id="avatarsHintLabel"
                                   text=""
                                   styleClass="profile-subtitle"/>
                        </VBox>

                    </HBox>

                    <HBox spacing="12" styleClass="profile-stats">
                        <VBox spacing="4" styleClass="profile-stat-card">
                            <Label text="Total Games" styleClass="profile-stat-title"/>
                            <Label fx:id="totalGamesLabel" text="0" styleClass="profile-stat-value"/>
                        </VBox>
                        <VBox spacing="4" styleClass="profile-stat-card">
                            <Label text="Wins / Losses" styleClass="profile-stat-title"/>
                            <Label fx:id="winsLossesLabel" text="0 / 0" styleClass="profile-stat-value"/>
                        </VBox>
                        <VBox spacing="4" styleClass="profile-stat-card">
                            <Label text="Win Rate" styleClass="profile-stat-title"/>
                            <Label fx:id="winRateLabel" text="0%" styleClass="profile-stat-value"/>
                        </VBox>
                        <VBox spacing="6" styleClass="profile-stat-card" prefWidth="220">

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ImageView fx:id="giftImageView"
                                           fitWidth="22" fitHeight="22"
                                           preserveRatio="true" smooth="true"/>
                                <Label text="Gift" styleClass="profile-stat-title"/>
                            </HBox>

                            <Label fx:id="giftProgressLabel"
                                   text="Wins until gift: 0/3"
                                   styleClass="profile-stat-value"/>

                            <ProgressBar fx:id="giftProgressBar" progress="0" prefWidth="220"/>

                            <Button fx:id="openGiftBtn"
                                    text="🔒 Not ready"
                                    onAction="#onOpenGiftInProfile"
                                    disable="true"
                                    styleClass="profile-back"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="10" styleClass="profile-card">
                        <Label text="Owned Avatars" styleClass="profile-sidebar-title"/>
                        <FlowPane fx:id="avatarsFlow"
                                  hgap="14"
                                  vgap="14"
                                  prefWrapLength="560"/>
                    </VBox>
                </VBox>

                <!-- RIGHT PANEL (Teammate) -->
                <VBox spacing="14" HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="14" styleClass="profile-card">
                        <ImageView fx:id="avatarViewRight"
                                   fitWidth="64" fitHeight="64"
                                   preserveRatio="true"
                                   smooth="true"
                                   styleClass="profile-avatar"/>
                        <VBox spacing="6">
                            <Label fx:id="playerNameLabelRight"
                                   text="No Teammate yet"
                                   styleClass="profile-name"/>
                            <Label fx:id="playerSubtitleLabelRight"
                                   text="Teammate Profile"
                                   styleClass="profile-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <VBox spacing="4" alignment="CENTER_RIGHT">
                            <Label fx:id="coinsLabelRight"
                                   text="Coins: 0"
                                   styleClass="profile-subtitle"/>
                            <Label fx:id="selectedAvatarLabelRight"
                                   text="Selected Avatar: -"
                                   styleClass="profile-subtitle"/>
                            <Label fx:id="avatarsHintLabelRight"
                                   text=""
                                   styleClass="profile-subtitle"/>
                        </VBox>

                    </HBox>

                    <HBox spacing="12" styleClass="profile-stats">
                        <VBox spacing="4" styleClass="profile-stat-card">
                            <Label text="Total Games" styleClass="profile-stat-title"/>
                            <Label fx:id="totalGamesLabelRight" text="0" styleClass="profile-stat-value"/>
                        </VBox>
                        <VBox spacing="4" styleClass="profile-stat-card">
                            <Label text="Wins / Losses" styleClass="profile-stat-title"/>
                            <Label fx:id="winsLossesLabelRight" text="0 / 0" styleClass="profile-stat-value"/>
                        </VBox>
                        <VBox spacing="4" styleClass="profile-stat-card">
                            <Label text="Win Rate" styleClass="profile-stat-title"/>
                            <Label fx:id="winRateLabelRight" text="0%" styleClass="profile-stat-value"/>
                        </VBox>
                        <VBox spacing="6" styleClass="profile-stat-card" prefWidth="220">

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <ImageView fx:id="giftImageViewRight"
                                           fitWidth="22" fitHeight="22"
                                           preserveRatio="true" smooth="true"/>
                                <Label text="Gift" styleClass="profile-stat-title"/>
                            </HBox>

                            <Label fx:id="giftProgressLabelRight"
                                   text="Wins until gift: 0/3"
                                   styleClass="profile-stat-value"/>

                            <ProgressBar fx:id="giftProgressBarRight" progress="0" prefWidth="220"/>

                            <Button fx:id="openGiftBtnRight"
                                    text="🔒 Not ready"
                                    disable="true"
                                    styleClass="profile-back"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="10" styleClass="profile-card">
                        <Label text="Owned Avatars" styleClass="profile-sidebar-title"/>
                        <FlowPane fx:id="avatarsFlowRight"
                                  hgap="14"
                                  vgap="14"
                                  prefWrapLength="560"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- TABLE -->
            <TableView fx:id="matchesTable" styleClass="profile-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="playedAtCol" text="Played At" prefWidth="160"/>
                    <TableColumn fx:id="TeammateCol" text="Teammate" prefWidth="140"/>
                    <TableColumn fx:id="resultCol" text="Result" prefWidth="90"/>
                    <TableColumn fx:id="scoreCol" text="Score" prefWidth="90"/>
                    <TableColumn fx:id="durationCol" text="Duration (s)" prefWidth="120"/>
                    <TableColumn fx:id="boardSizeCol" text="Board" prefWidth="90"/>
                    <TableColumn fx:id="difficultyCol" text="Difficulty" prefWidth="120"/>
                </columns>
            </TableView>

        </VBox>
    </children>
</AnchorPane>
