<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="main.controller.ResultController"
           fx:id="root"
           stylesheets="@/css/result.css"
           styleClass="result-root">

    <children>
        <VBox alignment="CENTER"
              spacing="14"
              maxWidth="420"
              prefWidth="380"
              maxHeight="520"
              styleClass="result-card">

            <padding>
                <Insets top="18" right="20" bottom="22" left="20"/>
            </padding>

            <children>

                <!-- GIF / image area -->
                <Label fx:id="gifLabel"
                       styleClass="result-gif-placeholder"/>

                <!-- Emoji + title -->
                <Label fx:id="emojiLabel"
                       text="😈"
                       styleClass="result-emoji"/>

                <Label fx:id="titleLabel"
                       text="Lions took over!"
                       styleClass="result-title"/>

                <Label fx:id="subtitleLabel"
                       text="No hearts left..."
                       styleClass="result-subtitle"/>

                <!-- Score Box -->
                <VBox alignment="CENTER" spacing="6" styleClass="score-box">
                    <children>
                        <HBox alignment="CENTER" spacing="6">
                            <children>
                                <Label text="🏆" styleClass="score-trophy"/>
                                <Label text="Score" styleClass="score-caption"/>
                                <Label text="🏆" styleClass="score-trophy"/>
                            </children>
                        </HBox>

                        <Label fx:id="scoreValueLabel"
                               text="0"
                               styleClass="score-value"/>

                        <Label fx:id="scoreLabel"
                               text="(+0 from hearts)"
                               styleClass="score-details"/>
                    </children>
                </VBox>

                <!-- Players -->
                <HBox alignment="CENTER" spacing="14">
                    <children>

                        <VBox alignment="CENTER" spacing="4" styleClass="player-pill">
                            <children>
                                <Label text="🦁" styleClass="player-emoji"/>
                                <Label fx:id="playerALabel"
                                       text="Player A"
                                       styleClass="player-name"/>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" styleClass="player-pill">
                            <children>
                                <Label text="🦁" styleClass="player-emoji"/>
                                <Label fx:id="playerBLabel"
                                       text="Player B"
                                       styleClass="player-name"/>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <Label fx:id="heartsLabel"
                       text="Hearts: 0"
                       styleClass="result-hearts"/>

                <Region prefHeight="8" styleClass="divider"/>

                <Label fx:id="quoteLabel"
                       text="Even kings can fall"
                       wrapText="true"
                       styleClass="result-quote"/>

                <!-- Bottom buttons -->
                <HBox alignment="CENTER" spacing="14">
                    <children>

                        <!-- Home button -->
                        <Button fx:id="homeButton"
                                id="homeButton"
                                text="Home"
                                onAction="#onHome"
                                styleClass="result-button secondary-button">
                            <tooltip>
                                <Tooltip text="Return to the main menu"/>
                            </tooltip>
                        </Button>

                        <!-- New Game button -->
                        <Button fx:id="playAgainButton"
                                id="playAgainButton"
                                text="New Game"
                                onAction="#onPlayAgain"
                                styleClass="result-button primary-button">
                            <tooltip>
                                <Tooltip text="Play again with the same settings"/>
                            </tooltip>
                        </Button>

                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</StackPane>
